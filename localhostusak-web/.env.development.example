# Göreli /api: istekler Vite dev proxy'si üzerinden CMS_PROXY_TARGET adresine gider.
VITE_API_URL=/api

# Vite dev proxy'sinin (/api ve /media) CMS adresi. Verilmezse varsayılan http://localhost:3000.
# CMS'i farklı portta çalıştırıyorsanız (3000 doluysa) .env.development.local'da override edin.
# VITE_ öneki yok: tarayıcı paketine girmez, yalnızca dev sunucusu okur.
# CMS_PROXY_TARGET=http://localhost:3000
